{
  "name": "chess-vision-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest run engine/__tests__/lichess-benchmark.test.ts",
    "llm:eval": "vitest run llm/__tests__/llm-eval.test.ts",
    "llm:commentary": "vite-node --script llm/run.ts",
    "arena:ooda": "vite-node --script arena/ooda.ts",
    "chessbench:import": "vite-node --script arena/chessbench-import.ts",
    "dataset:relabel": "vite-node --script arena/relabel-evals.ts",
    "eval:value": "vite-node --script arena/eval-value.ts",
    "train:ranking": "vite-node --script arena/train-ranking.ts",
    "train:mixed": "vite-node --script arena/train-mixed.ts",
    "train:rung3": "vite-node --script arena/train-rung3-net.ts",
    "rung2:dump": "vite-node --script arena/rung2-dump.ts",
    "forensic:blunder": "vite-node --script arena/forensic-blunder.ts",
    "pv:attribution": "vite-node --script arena/pv-attribution.ts",
    "eval:matrix": "vite-node --script arena/eval-matrix.ts",
    "bench:search": "vite-node --script arena/bench-search.ts",
    "perft:chessjs": "vite-node --script arena/perft-chessjs.ts",
    "export:eval-fixtures": "vite-node --script arena/export-eval-fixtures.ts",
    "eval:r4": "vite-node --script arena/eval-r4.ts",
    "gauntlet:play": "vite-node --script arena/gauntlet-play.ts",
    "gauntlet:score": "vite-node --script arena/gauntlet-score.ts",
    "gauntlet:analyze": "vite-node --script arena/gauntlet-analyze.ts",
    "engine:compare": "vite-node --script arena/engine-compare.ts",
    "forensic:loss": "vite-node --script arena/forensic-loss.ts",
    "gauntlet:digest": "vite-node --script arena/gauntlet-live-digest.ts",
    "teaching:audit": "vite-node --script arena/teaching-audit.ts",
    "teaching:replay": "vite-node --script arena/teaching-replay.ts",
    "train:loop": "vite-node --script arena/train-loop.ts",
    "training:ui": "vite --host 127.0.0.1 --port 5174",
    "lichess:import": "vite-node --script arena/lichess/import-db.ts",
    "dataset:train": "vite-node --script arena/train-dataset.ts",
    "lichess:account": "vite-node --script arena/lichess/account.ts",
    "lichess:upgrade": "vite-node --script arena/lichess/upgrade.ts",
    "lichess:bot": "vite-node --script arena/lichess/run.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@cvs/engine": "file:../chess-vision-studio-engine",
    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.42",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "stockfish": "16.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
