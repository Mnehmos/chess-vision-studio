# Chess Vision Studio — LLM narrator/eval (OpenAI). Copy to .env and fill in.
# The LLM is CLAMPED (Invariant 8): it narrates engine-VALIDATED MoveAnalysis
# facts and never asserts a tactic that isn't already in the analysis.

# Your OpenAI API key (required to run `npm run llm:eval`).
OPENAI_API_KEY=sk-your-key-here

# Model id. The user requested GPT-5.5; override if your account uses a different id.
OPENAI_MODEL=gpt-5.5

# API base (override for Azure/proxies/compatible endpoints).
OPENAI_BASE_URL=https://api.openai.com/v1

# Engine search depth used to produce the MoveAnalysis fed to the LLM.
LLM_ANALYSIS_DEPTH=14

# How many plies to narrate concurrently (the "batch" width).
LLM_CONCURRENCY=4

# Optional: cap how many plies to narrate (0 = whole game).
LLM_MAX_PLIES=0
