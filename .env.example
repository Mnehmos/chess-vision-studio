# Chess Vision Studio - LLM narrator/eval (OpenAI). Copy to .env or .env.local and fill in.
# The LLM is CLAMPED (Invariant 8): it narrates engine-VALIDATED MoveAnalysis
# facts and never asserts a tactic that isn't already in the analysis.

# Your OpenAI API key for the Node-side CLI scripts (llm/run.ts).
OPENAI_API_KEY=sk-your-key-here

# IN-APP commentary button: Vite only exposes VITE_-prefixed vars to the browser.
# Setting this embeds the key in the client bundle — fine for a LOCAL 127.0.0.1 tool,
# but for safety prefer pasting the key into the app's "Coach commentary" panel
# (stored in this browser's localStorage, never bundled or committed).
# VITE_OPENAI_API_KEY=sk-your-key-here

# Model id (the user requested GPT-5.5). VITE_OPENAI_MODEL overrides it in the app.
OPENAI_MODEL=gpt-5.5
# VITE_OPENAI_MODEL=gpt-5.5

# API base (override for Azure/proxies/compatible endpoints).
OPENAI_BASE_URL=https://api.openai.com/v1

# Local CVS Engine bridge (Vite dev server only).
# Build the sibling repo first:
#   cd ../chess-vision-studio-rust-engine
#   cargo build --release
#
# Windows default:
CVS_RUST_EXE=../chess-vision-studio-rust-engine/target/release/analyze.exe
# macOS/Linux default:
# CVS_RUST_EXE=../chess-vision-studio-rust-engine/target/release/analyze
CVS_RUST_DEPTH=6
CVS_RUST_BASE=arena/out/value-weights-mixed.json
CVS_RUST_RUNG2=arena/out/rung2-weights-mixed.json

# Stable Gen7-era search patch used by the local CVS Engine panel.
CVS_RUST_FUTILITY=1

# Experimental search gates. Leave off unless you are running a controlled A/B.
CVS_RUST_RFP=0
CVS_RUST_LMP=0
CVS_RUST_SEEPRUNE=0
CVS_RUST_DELTA=0
CVS_RUST_COUNTERMOVE=0
CVS_RUST_CONTHIST=0
CVS_RUST_TTPS=0
CVS_RUST_QTT=0
CVS_RUST_TT2=0
CVS_RUST_IMPROVING=0
CVS_RUST_RULE50=0

# Engine search depth used to produce the MoveAnalysis fed to the LLM.
LLM_ANALYSIS_DEPTH=14

# How many plies to narrate concurrently (the "batch" width).
LLM_CONCURRENCY=4

# Optional: cap how many plies to narrate (0 = whole game).
LLM_MAX_PLIES=0

# ─── Lichess bot (arena/lichess) ──────────────────────────────────────────────
# Live game diversity for the OODA loop: CvsEngine plays real Lichess opponents.
# SECURITY: this token stays server-side (Node arena scripts only). It is NEVER
# VITE_-prefixed, so it is never bundled into the browser. .env is gitignored.
#
# Setup (see arena/lichess/README.md):
#   1. Create a FRESH Lichess account; play ZERO games on it.
#   2. Make a personal token at lichess.org/account/oauth/token/create with the
#      "bot:play" scope ONLY (least privilege).
#   3. Upgrade it (IRREVERSIBLE, gameless accounts only):
#      curl -d "" https://lichess.org/api/bot/account/upgrade -H "Authorization: Bearer <TOKEN>"
#   4. Put the token below, then: npm run lichess:account  (verify) → npm run lichess:bot
LICHESS_BOT_TOKEN=your-token-here
LICHESS_BOT_USERNAME=ChessVisionStudioEng

# CVS search depth per move (higher = stronger/slower).
LICHESS_BOT_DEPTH=3
# Optional trained policy weights from npm run dataset:train.
LICHESS_WEIGHTS=arena/out/weights.json

# Challenge-accept policy.
LICHESS_ACCEPT_CASUAL=1
LICHESS_ACCEPT_RATED=1
LICHESS_BOTS_ONLY=0
# Decline real-time games with an initial clock below this (seconds): engines want thinking time.
LICHESS_MIN_CLOCK_SEC=180
LICHESS_ALLOW_CORRESPONDENCE=1
LICHESS_MAX_GAMES=1

# Seed games at startup by challenging Lichess AI (Stockfish levels 1–8).
LICHESS_SEED_AI=0
LICHESS_SEED_AI_LEVELS=3,5,7
LICHESS_SEED_AI_CLOCK_SEC=300
LICHESS_SEED_AI_INC_SEC=3

# Harvest finished games into the OODA dataset (needs Stockfish; writes arena/out/lichess-dataset.jsonl).
LICHESS_REVIEW=0
LICHESS_REVIEW_DEPTH=10
LICHESS_OUT_DIR=arena/out

# Champion stack (2026-06-12)
CVS_RUST_NNUE=arena/out/gen8-raw-h256-v2.json
CVS_RUST_RFP=1
CVS_RUST_TTPS=1
CVS_RUST_QTT=1
CVS_RUST_HISTMALUS=1
CVS_RUST_HISTLMR=1
